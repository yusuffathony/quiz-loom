{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-loom",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUIZ_ROOM",
        "class_name": "QuizRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["QuizRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quiz-loom-db",
      "database_id": "quiz-loom-db-local"
    }
  ]
}
