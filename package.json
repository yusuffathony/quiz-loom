{
  "name": "quiz-loom",
  "version": "1.0.0",
  "description": "Live multiplayer quiz platform with real-time scoring, host controls, and animated leaderboards",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/**/*.test.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate": "wrangler d1 execute quiz-loom-db --local --file=./schema.sql",
    "d1:migrate:prod": "wrangler d1 execute quiz-loom-db --remote --file=./schema.sql"
  },
  "keywords": [
    "quiz",
    "socket.io",
    "realtime",
    "multiplayer",
    "kahoot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  }
}
